# services/core-api — environment variables.
#
# core-api doesn't exist as runnable code yet (this file is scaffolded by PR 1 of
# backend-core-api-foundation, the toolchain PR). Every var below is documented by a
# later PR's spec, not invented here — see the pointer per section. All are validated
# fail-fast at boot by `src/config/env.schema.ts` (core-api-bootstrap, PR 3): the
# process exits non-zero before `listen()` if a required var for the selected mode is
# missing, never a silent "run without auth" degradation.
#
# Copy to `.env` for local dev; `.env`/`.env.*` are gitignored (`!.env.example` is the
# one tracked exception).

# --- Supabase (core-api-bootstrap) ---------------------------------------------------
# Project URL, e.g. http://127.0.0.1:54321 for local `supabase start`.
SUPABASE_URL=
# service_role key — server-side only, never shipped to a client. Required
# unconditionally (same fail-fast class as DATABASE_URL below).
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (core-api-bootstrap, design.md D-A) ------------------------------------
# `pg`/Kysely connection string. MUST resolve to a role carrying `service_role`
# grants (not the `postgres` table-owner role) — see design.md D-A's open question on
# `SET ROLE service_role` vs. a dedicated login role, closed by PR 4's grants test.
DATABASE_URL=

# --- JWT verification (core-api-bootstrap, design.md D-D) ----------------------------
# Discriminated union selected once at boot, never per-request: hs256 (dev default —
# `supabase start` ships a static HS256 secret) or jwks (production target, once the
# real Supabase project exists).
AUTH_JWT_MODE=hs256
# Required iff AUTH_JWT_MODE=hs256.
SUPABASE_JWT_SECRET=
# Required iff AUTH_JWT_MODE=jwks.
SUPABASE_JWKS_URL=
# Always required regardless of mode.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=authenticated

# --- Process (core-api-bootstrap, PR 3) ----------------------------------------------
# Neither var is validated fail-fast (both have safe defaults) — unlike everything
# above, missing them degrades gracefully instead of halting boot.
NODE_ENV=development
PORT=3000
