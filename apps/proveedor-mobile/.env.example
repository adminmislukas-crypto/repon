# apps/proveedor-mobile — environment variables.
#
# Expo inlines every `EXPO_PUBLIC_*` var into the JS bundle at build/start
# time (client-visible by design — never put a secret here). Copy to `.env`
# for local dev; `.env`/`.env.*` are gitignored (`!.env.example` tracked).

# core-api's base URL, no trailing slash — mobile-auth-login design.md D-6:
# the app is the only place this is read; @repon/auth itself never touches
# process.env. Local dev against `pnpm --filter core-api start:dev`:
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
