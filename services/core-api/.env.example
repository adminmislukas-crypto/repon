# services/core-api — environment variables.
#
# core-api doesn't exist as runnable code yet (this file is scaffolded by PR 1 of
# backend-core-api-foundation, the toolchain PR). Every var below is documented by a
# later PR's spec, not invented here — see the pointer per section. All are validated
# fail-fast at boot by `src/config/env.schema.ts` (core-api-bootstrap, PR 3): the
# process exits non-zero before `listen()` if a required var for the selected mode is
# missing, never a silent "run without auth" degradation.
#
# Copy to `.env` for local dev; `.env`/`.env.*` are gitignored (`!.env.example` is the
# one tracked exception).

# --- Supabase (core-api-bootstrap) ---------------------------------------------------
# Project URL, e.g. http://127.0.0.1:54321 for local `supabase start`.
SUPABASE_URL=
# service_role key — server-side only, never shipped to a client. Required
# unconditionally (same fail-fast class as DATABASE_URL below).
SUPABASE_SERVICE_ROLE_KEY=
# anon key — mobile-auth-login design.md D-1: what `GoTrueAuthClient` sends
# as `apikey`/`Authorization` on the password/refresh grants against GoTrue.
# Never the service-role key above, and never shipped to a mobile client
# either — only core-api calls GoTrue directly. Required unconditionally.
SUPABASE_ANON_KEY=

# --- Postgres (core-api-bootstrap, design.md D-A) ------------------------------------
# `pg`/Kysely connection string. MUST authenticate as a login role that is a MEMBER of
# `service_role` — `service_role` itself cannot log in directly (verified: `rolcanlogin
# = false` on the local stack). `shared/database/pool.provider.ts` runs `SET ROLE
# service_role` on every new physical connection (`service_role` is NOINHERIT-granted to
# the login role, so membership alone isn't enough); design.md D-A's open question is
# closed by PR 4's integration test (`test/database.integration-spec.ts`), which asserts
# `UPDATE audit_log` is rejected under this exact connection strategy.
#
# Local dev (`supabase start`): use the `authenticator` role — the same login role
# PostgREST itself connects as, already a member of `service_role`, password matches
# the local stack's `postgres` user password:
#   postgresql://authenticator:postgres@127.0.0.1:54322/postgres
#
# Hosted/production: a hosted Supabase project does NOT expose `authenticator`'s
# credentials for direct external connections. A dedicated login role granted
# membership in `service_role` (design.md's other alternative) needs its own migration
# — this is a documented follow-up, not yet provisioned by this change. Do NOT default
# to the project's `postgres` connection string here: `postgres` owns every table and
# silently bypasses the `REVOKE UPDATE, DELETE ... FROM service_role` grants that make
# `audit_log`/`order_items` append-only (design.md D-A risk #1).
DATABASE_URL=

# --- JWT verification (core-api-bootstrap, design.md D-D) ----------------------------
# Discriminated union selected once at boot, never per-request: hs256 (legacy static
# shared-secret signing) or jwks (dev AND production default — see below).
#
# jwks is the local dev default: current `supabase start` (CLI >= 2.x) issues GoTrue
# tokens signed with an asymmetric JWT Signing Key (ES256), not the legacy static
# HS256 secret `supabase status -o env` still prints for backward compat — a token
# signed that way fails `Hs256JwtVerifier`'s `algorithms: ['HS256']` check outright
# (wrong algorithm, not an expired/malformed token), which surfaces as every protected
# route 401ing with INVALID_TOKEN right after a successful login. hs256 only applies
# against an older local stack (or a hosted project) still on static secret signing.
AUTH_JWT_MODE=jwks
# Required iff AUTH_JWT_MODE=hs256. Local dev value: `supabase status -o env`'s
# JWT_SECRET.
SUPABASE_JWT_SECRET=
# Required iff AUTH_JWT_MODE=jwks. Local dev: `${SUPABASE_URL}/auth/v1/.well-known/jwks.json`
# (e.g. http://127.0.0.1:54321/auth/v1/.well-known/jwks.json).
SUPABASE_JWKS_URL=
# Always required regardless of mode.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=authenticated

# --- Process (core-api-bootstrap, PR 3) ----------------------------------------------
# Neither var is validated fail-fast (both have safe defaults) — unlike everything
# above, missing them degrades gracefully instead of halting boot.
NODE_ENV=development
PORT=3000
# mobile-auth-login design.md D-3: hops of X-Forwarded-For to trust for
# req.ip (Express `trust proxy`). 0 is correct for local dev with no reverse
# proxy in front; set to the real hop count behind a load balancer, or the
# per-IP login rate limit degrades into one shared bucket for every request.
TRUST_PROXY_HOPS=0
# mobile-auth-login: comma-separated allowlist for the browser CORS preflight
# (both mobile apps run as a web target on a different port than core-api).
# Defaults to both local Expo web ports if unset — override to the real app
# origin(s) outside local dev.
CORS_ALLOWED_ORIGINS=http://localhost:8091,http://localhost:8092
